{
  "_comentario": "Trecho que o instalador adiciona em ~/.claude/settings.json. Só pra referência; o instalar.command faz isso sozinho.",
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "$HOME/.bigodinho/hook.sh", "timeout": 5 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "$HOME/.bigodinho/hook.sh", "timeout": 5 } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "$HOME/.bigodinho/hook.sh", "timeout": 5 } ] }
    ],
    "PreToolUse": [
      { "hooks": [ { "type": "command", "command": "$HOME/.bigodinho/hook.sh", "timeout": 5 } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "$HOME/.bigodinho/hook.sh", "timeout": 5 } ] }
    ],
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "$HOME/.bigodinho/hook.sh", "timeout": 5 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "$HOME/.bigodinho/hook.sh", "timeout": 5 } ] }
    ]
  }
}
